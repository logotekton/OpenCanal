# ───────── Database ─────────
DATABASE_URL="postgresql://opencanal:opencanal_dev@localhost:5433/opencanal"
# docker-compose.prod.yml 용:
POSTGRES_USER="opencanal"
POSTGRES_PASSWORD=""            # 필수 (prod)
POSTGRES_DB="opencanal"

# ───────── Auth (apps/web) ─────────
AUTH_SECRET=""                  # 필수 — 생성: npx auth secret
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true
# Google OAuth (설정 시 자동 활성화 — 프로덕션 권장)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# 비밀번호 없는 개발용 이메일 로그인 (프로덕션에서는 반드시 false)
ALLOW_DEV_LOGIN=true
# 콤마 구분 관리자 이메일 (검증 심사 큐 접근)
ADMIN_EMAILS=""

# ───────── Gateway ─────────
GATEWAY_PORT=8787
# web → gateway 내부 알림 인증 시크릿 (필수, 충분히 긴 랜덤 문자열)
GATEWAY_INTERNAL_SECRET=""
# web이 게이트웨이에 접근할 내부 URL (compose에서는 http://gateway:8787)
GATEWAY_HTTP_URL="http://localhost:8787"

# ───────── Web public ─────────
NEXT_PUBLIC_GATEWAY_WS_URL="ws://localhost:8787"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
