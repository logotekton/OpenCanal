generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Enums ─────────────────────────

enum UserRole {
  user
  admin
}

enum AgentType {
  personal
  business
  enterprise
  government
  expert
}

enum AgentStatus {
  online
  away
  offline
}

// v1 계획서의 L0~L5 등급 체계 유지. MVP 실사용은 L0~L2 (L2+ = 주황 딱지)
enum VerificationLevel {
  L0
  L1
  L2
  L3
  L4
  L5
}

enum RequestState {
  pending
  approved
  rejected
}

enum SourceStatus {
  pending
  linked
  error
}

enum RoomType {
  question
  discussion
  trade
  help
}

enum RoomStatus {
  open
  closed
}

enum ParticipantRole {
  initiator
  responder
}

enum AuthorKind {
  agent
  human
  system
}

enum MessageStatus {
  pending
  delivered
  answered
  failed
}

enum ApprovalState {
  none
  required
  approved
  rejected
}

enum InstructionStatus {
  pending
  processed
  failed
}

// 영수증 생애주기 — 합의 확정(confirmed) → 이행 완료(fulfilled) 또는 분쟁(disputed).
// 평판 v1의 이행률/분쟁률은 이 상태 전이로 계산된다 (자기소개가 아닌 실행 결과).
enum ReceiptStatus {
  confirmed
  fulfilled
  disputed
}

// agent의 출처 (docs/CONNECT_PLAN.md). 통치 범위(governanceScope)가 여기서 갈린다:
// native·persona_linked = full(두뇌 네이티브), imported_runtime = in_network(외부 두뇌).
enum AgentOrigin {
  native // OpenCanal에서 직접 생성 (두뇌=러너)
  persona_linked // 외부 정체성/페르소나(OpenCrab) 연결, 두뇌는 네이티브
  imported_runtime // 외부 두뇌(OpenClaw/Hermes) — 통치 in_network
}

// ───────────────────────── Auth (Auth.js) ─────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          UserRole  @default(user)
  createdAt     DateTime  @default(now())

  accounts      Account[]
  sessions      Session[]
  agents        Agent[]
  notifications Notification[]

  reviewedRequests VerificationRequest[] @relation("reviewer")
  approvedBadges   VerificationBadge[]   @relation("badgeApprover")
  acceptedReceipts ContractReceipt[]     @relation("receiptAcceptor")
  telegramLinks    TelegramLink[]
  bridgePairings   BridgePairing[]
  provisionGrants  ProvisionGrant[]
  intents          Intent[]
}

// ───────────────────────── Telegram bridge (R1) ─────────────────────────
// 소유자가 메신저에서 자기 agent를 지시·승인·알림받는 채널 (룸 구조는 그대로, 텔레그램은
// 소유자↔자기 agent 채널). apps/bridge 워커가 TELEGRAM_BOT_TOKEN이 있을 때 가동된다.

model TelegramLink {
  id        String   @id @default(cuid())
  chatId    String   @unique // 텔레그램 chat id
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// 웹에서 발급하는 단명 링크 코드 — 사용자가 봇에 `/pair <code>`로 입력하면 chatId가 연결된다.
model BridgePairing {
  id         String    @id @default(cuid())
  code       String    @unique
  userId     String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 사용자 알림 — 대리 구조의 신경계. 승인 요청/지시 실패/검증 결과/거래 확정이 흐른다.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String // approval_required | instruction_failed | verification_reviewed | receipt_created
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ───────────────────────── Agents ─────────────────────────

model Agent {
  id          String      @id @default(cuid())
  ownerId     String
  type        AgentType   @default(personal)
  handle      String      @unique
  displayName String
  bio         String?
  status      AgentStatus @default(offline)

  lastHeartbeatAt   DateTime?
  verificationLevel VerificationLevel @default(L0)
  // 출처 — 통치 범위/신뢰 표시의 근거 (verificationLevel과 독립: 출처는 검증이 아니다)
  origin            AgentOrigin       @default(native)

  // v1 Mandate 축약형: can_speak/can_advise 기본 on, can_negotiate/can_commit/can_spend 기본 off
  permissions Json @default("{\"can_speak\":true,\"can_advise\":true,\"can_negotiate\":false,\"can_commit\":false,\"can_spend\":false}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner                User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  badge                VerificationBadge?
  verificationRequests VerificationRequest[]
  sources              AgentSource[]
  device               RunnerDevice?
  pairings             DevicePairing[]
  participations       RoomParticipant[]
  messages             Message[]
  approvalRequests     ApprovalRequest[]
  instructions         Instruction[]
  capabilities         AgentCapability[]
  externalLink         ExternalAgentLink?
  intents              Intent[]

  @@index([ownerId])
  @@index([type, verificationLevel])
}

// 외부에서 프로비전된 agent ↔ 출처 매핑 (docs/CONNECT_PLAN.md). (source, externalId) 유일 →
// 재연결이 중복 생성이 아니라 갱신이 되게 한다. 출처는 중립 라벨일 뿐 검증 신호가 아니다.
model ExternalAgentLink {
  id          String   @id @default(cuid())
  agentId     String   @unique
  source      String // opencrab | openclaw | hermes
  externalId  String
  externalUrl String?
  createdAt   DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
}

// 소유자가 외부 agent를 연결하기 위해 발급하는 단명 코드 (provision-by-connection).
// DevicePairing(agent 단위)과 달리 소유자(계정) 단위 — agent를 미리 만들지 않으므로.
model ProvisionGrant {
  id         String    @id @default(cuid())
  code       String    @unique
  userId     String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// agent가 수행할 수 있다고 선언하는 능력(skill). 외부 런타임(Moltbot/Hermes 등)의 skill을
// 어댑터가 OpenCanal capability로 매핑한다(source=adapter). 모든 능력은 "승인 봉투" 안 —
// requiresApproval 기본 on, 실제 수행은 기존 승인 게이트를 거친다 (자동 실행 없음).
model AgentCapability {
  id               String   @id @default(cuid())
  agentId          String
  key              String // 안정 식별자 (예: lodging.book, code.review)
  label            String
  description      String?
  enabled          Boolean  @default(true)
  requiresApproval Boolean  @default(true)
  source           String   @default("manual") // manual(소유자) | adapter(런타임 동기화)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, key])
  @@index([agentId])
}

model VerificationBadge {
  id           String            @id @default(cuid())
  agentId      String            @unique
  level        VerificationLevel
  kind         AgentType
  approvedById String?
  approvedAt   DateTime          @default(now())
  evidenceNote String?

  agent      Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  approvedBy User? @relation("badgeApprover", fields: [approvedById], references: [id])
}

model VerificationRequest {
  id             String            @id @default(cuid())
  agentId        String
  requestedLevel VerificationLevel
  evidence       Json // { note, businessRegistration?, officialUrl?, contact? }
  state          RequestState      @default(pending)
  reviewerId     String?
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime          @default(now())

  agent    Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  reviewer User? @relation("reviewer", fields: [reviewerId], references: [id])

  @@index([state])
}

// 플러그인式 페르소나 소스. kind는 코드 레지스트리 키 (opencrab_pack | manual_profile | ...)
// config에는 비밀이 아닌 메타데이터만 — ocm_ 토큰은 절대 저장하지 않는다 (러너 로컬 전용)
model AgentSource {
  id        String       @id @default(cuid())
  agentId   String
  kind      String
  config    Json // opencrab_pack: { packId, tenantId?, manifestHash?, nodeCount?, spaces?, attestedAt? } / manual_profile: { tastes, hobbies, skills, ... }
  status    SourceStatus @default(pending)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
}

// ───────────────────────── Runner ─────────────────────────

model RunnerDevice {
  id            String    @id @default(cuid())
  agentId       String    @unique
  tokenHash     String    @unique // SHA-256(deviceToken) — 원문은 러너만 보유
  name          String?
  runnerVersion String?
  lastSeenAt    DateTime?
  createdAt     DateTime  @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model DevicePairing {
  id         String    @id @default(cuid())
  agentId    String
  code       String    @unique // 8자리 페어링 코드
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

// ───────────────────────── Rooms & Messages ─────────────────────────

// 흐르는 단위 (ROOM_REDESIGN Bend 2): 소유자가 자기 agent를 통해 원하는 것.
// 룸/세션은 이 Intent를 이행한다. Instruction(룸 내 지시)의 상위 일반화.
model Intent {
  id           String   @id @default(cuid())
  createdById  String // user
  onBehalfOfId String // agent (대리자)
  kind         String // question | advice | trade | debate | help
  spec         Json // { goal, constraints?, budget?, vertical? }
  status       String   @default("open") // open|matching|in_session|settled|cancelled
  createdAt    DateTime @default(now())

  createdBy  User  @relation(fields: [createdById], references: [id], onDelete: Cascade)
  onBehalfOf Agent @relation(fields: [onBehalfOfId], references: [id], onDelete: Cascade)
  rooms      Room[]

  @@index([createdById])
  @@index([onBehalfOfId, status])
}

model Room {
  id          String     @id @default(cuid())
  type        RoomType   @default(question)
  status      RoomStatus @default(open)
  title       String?
  intentId    String? // ROOM_REDESIGN Bend 2: 이 룸이 이행하는 Intent
  createdById String // User id
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  intent       Intent?           @relation(fields: [intentId], references: [id])
  participants RoomParticipant[]
  messages     Message[]
  instructions Instruction[]
  receipts     ContractReceipt[]

  @@index([intentId])
}

// 사용자 → 자기 agent에 대한 지시. 사용자는 상대 agent와 직접 대화하지 않는다 —
// agent가 지시를 해석해 자기 목소리로 메시지를 작성/전송한다.
model Instruction {
  id              String            @id @default(cuid())
  roomId          String
  agentId         String // 지시받는 agent (지시한 사용자의 소유)
  content         String
  status          InstructionStatus @default(pending)
  resultMessageId String? // agent가 이 지시로 작성한 메시지
  error           String?
  createdAt       DateTime          @default(now())
  processedAt     DateTime?

  room  Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, status])
  @@index([roomId, createdAt])
}

model RoomParticipant {
  roomId   String
  agentId  String
  role     ParticipantRole
  joinedAt DateTime        @default(now())

  room  Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([roomId, agentId])
  @@index([agentId])
}

model Message {
  id            String        @id @default(cuid())
  roomId        String
  senderAgentId String
  authorKind    AuthorKind    @default(agent)
  content       String
  // 타입드 Interaction (ROOM_REDESIGN Bend 1): 발화의 행위 종류. 채팅이 아니라 구조화 상호작용.
  interactionType String      @default("statement")
  // v1 Philosophy-for-AI 최소형: [{type: claim|evidence|interpretation|responsibility, text}]
  claims        Json?
  // 구조화 페이로드(PFA: originalClaim/evidence/counterargument/responsibility 등) — 사람용 content와 별개
  payload       Json?
  // 정책 레버 (ROOM_REDESIGN Bend 5, PFA PolicyLever): 서버가 rigor 평가로 설정. none|warn|reconfirm|human_approval|escalate|block
  policyLever   String      @default("none")
  status        MessageStatus @default(pending)
  approval      ApprovalState @default(none)
  inReplyToId   String?
  createdAt     DateTime      @default(now())

  room            Room             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender          Agent            @relation(fields: [senderAgentId], references: [id], onDelete: Cascade)
  inReplyTo       Message?         @relation("replies", fields: [inReplyToId], references: [id])
  replies         Message[]        @relation("replies")
  approvalRequest ApprovalRequest?
  receipt         ContractReceipt?

  @@index([roomId, createdAt])
  // inbox 드레인 / gateway pendingCount 의 (roomId, status[, createdAt]) 필터 커버
  @@index([roomId, status, createdAt])
  @@index([senderAgentId, status])
}

model ApprovalRequest {
  id        String       @id @default(cuid())
  messageId String       @unique
  agentId   String
  summary   String
  state     RequestState @default(pending)
  decidedAt DateTime?
  createdAt DateTime     @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  agent   Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, state])
}

// 합의의 기록 — trade 룸에서 상대 소유자가 "이 조건으로 확정"하면 생성되는 영수증.
// v1 BotContract Evidence Package의 최소형: 제안 메시지 + 대화 transcript hash.
model ContractReceipt {
  id                String   @id @default(cuid())
  roomId            String
  proposalMessageId String   @unique // 확정된 제안 (승인되어 전달된 agent 메시지)
  acceptedById      String // 확정한 사용자 (제안 받은 쪽 소유자)
  transcriptHash    String // 확정 시점까지의 전달된 대화 SHA-256
  terms             String // 제안 메시지 본문 스냅샷 (제안이 수정되어도 영수증은 불변)

  // 생애주기: confirmed(기본) → fulfilled(이행 완료) | disputed(분쟁 제기).
  // 결제·자동거래는 없다 — fulfilled는 "조건이 지켜졌다"는 당사자 기록일 뿐(can_spend off 유지).
  status      ReceiptStatus @default(confirmed)
  fulfilledAt DateTime?
  disputedAt  DateTime?
  note        String? // 이행/분쟁 사유 스냅샷

  // BotContract 조건표 (R4): [{label, value, met?}]. 숙박 등 vertical은 라벨 템플릿으로 구조화한다.
  // terms(자유 텍스트 스냅샷)와 별개 — 이행 시 met 플래그로 조건 충족을 기록한다.
  conditions Json?

  createdAt         DateTime @default(now())

  // 불변 증거: 기초가 되는 룸/제안 메시지를 지우면 영수증이 함께 사라지면 안 된다.
  // Restrict로 두어, 영수증이 존재하는 한 그 근거(room/proposal)를 삭제할 수 없게 한다.
  room       Room    @relation(fields: [roomId], references: [id], onDelete: Restrict)
  proposal   Message @relation(fields: [proposalMessageId], references: [id], onDelete: Restrict)
  acceptedBy User    @relation("receiptAcceptor", fields: [acceptedById], references: [id])

  @@index([roomId])
}
